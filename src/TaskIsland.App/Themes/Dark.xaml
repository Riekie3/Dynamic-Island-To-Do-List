<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- PLAN.md section 6.1, Dark. Same keys as Light.xaml; every brush frozen (section 6.7 rule 4). -->
    <SolidColorBrush x:Key="PillBrush" Color="#000000" po:Freeze="True"/>
    <!-- Undo / notice toasts over the panel (SILEO-PLAN.md S3): lighter than the dark panel, with a faint outline. -->
    <SolidColorBrush x:Key="PanelToastFillBrush" Color="#2B2E37" po:Freeze="True"/>
    <SolidColorBrush x:Key="PanelToastStrokeBrush" Color="#2EFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#121418" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#15171C" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#1AFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#17FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TopHighlightBrush" Color="#0FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA1AD" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7280" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F8CFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C9DFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F75E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#332F8CFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverdueBrush" Color="#FF6B6B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighDotBrush" Color="#FF6B6B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighBgBrush" Color="#24FF6B6B" po:Freeze="True"/>
    <SolidColorBrush x:Key="MediumDotBrush" Color="#F5B83D" po:Freeze="True"/>
    <SolidColorBrush x:Key="MediumBgBrush" Color="#24F5B83D" po:Freeze="True"/>
    <SolidColorBrush x:Key="LowDotBrush" Color="#3DD68C" po:Freeze="True"/>
    <SolidColorBrush x:Key="LowBgBrush" Color="#243DD68C" po:Freeze="True"/>
    <sys:Double x:Key="ShadowOpacity">0.35</sys:Double>
</ResourceDictionary>
