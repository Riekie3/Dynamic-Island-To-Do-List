<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- PLAN.md section 6.1, Light. The pill stays black in both themes, like a real island. -->
    <SolidColorBrush x:Key="PillBrush" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#121418" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFBFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0A000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#14000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#14000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TopHighlightBrush" Color="#00FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111318" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A606B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9099" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A6CF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A80F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#085BCB" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#260A6CF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverdueBrush" Color="#D22B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighDotBrush" Color="#D22B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighBgBrush" Color="#1AD22B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="MediumDotBrush" Color="#A86A00" po:Freeze="True"/>
    <SolidColorBrush x:Key="MediumBgBrush" Color="#1AA86A00" po:Freeze="True"/>
    <SolidColorBrush x:Key="LowDotBrush" Color="#11803F" po:Freeze="True"/>
    <SolidColorBrush x:Key="LowBgBrush" Color="#1A11803F" po:Freeze="True"/>
    <sys:Double x:Key="ShadowOpacity">0.14</sys:Double>
</ResourceDictionary>
