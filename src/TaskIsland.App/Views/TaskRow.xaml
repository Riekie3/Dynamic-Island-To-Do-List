<UserControl x:Class="TaskIsland.App.Views.TaskRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskIsland.App.Controls"
             xmlns:m="clr-namespace:TaskIsland.Core.Models;assembly=TaskIsland.Core"
             Focusable="False" RenderTransformOrigin="0.5,0">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <!-- Row actions show on hover and on keyboard focus (PLAN.md section 6.0). -->
        <Style x:Key="Actions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,8,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <!-- Shown while the row is not being edited / while it is. -->
        <Style x:Key="WhenViewing" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenEditing" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DropLine" TargetType="Border">
            <Setter Property="Height" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="RowScale"/>
            <TranslateTransform x:Name="RowSlide"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid>
        <Border x:Name="Root" CornerRadius="12" Padding="10,8,6,8" Margin="0,0,0,4" MinHeight="{DynamicResource RowMinHeight}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- ===== display ===== -->
                <Grid Style="{StaticResource WhenViewing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="Check" Style="{StaticResource RoundCheck}" IsChecked="{Binding IsCompleted}"
                              VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Title}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Left">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Strikethrough = a line whose opacity is animated (PLAN.md Phase 3 step 4). -->
                            <Border x:Name="StrikeLine" Height="1.5" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0"
                                    Width="{Binding ActualWidth, ElementName=TitleText}" IsHitTestVisible="False"
                                    Background="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ShowListName, Converter={StaticResource Vis}}">
                            <Ellipse Width="6" Height="6" Fill="{Binding ListBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ListName}" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0"
                                Visibility="{Binding HasDue, Converter={StaticResource Vis}}">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,4,0"/>
                        <TextBlock Text="{Binding DueText}"/>
                    </StackPanel>

                    <c:PriorityChip x:Name="Chip" Grid.Column="3" Priority="{Binding Priority}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0" Style="{StaticResource Actions}">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit (F2)"
                                AutomationProperties.Name="Edit task" Command="{Binding EditCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (Del)"
                                AutomationProperties.Name="Delete task" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== inline edit (PLAN.md section 6.5): labels beside the fields keep the form short ===== -->
                <StackPanel x:Name="EditPanel" Style="{StaticResource WhenEditing}" Margin="0,2,4,2">
                    <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" Tag="Task title" MaxLength="500"
                             AutomationProperties.Name="Task title" FontSize="14"
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="TitleBox_KeyDown"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Priority" Margin="2,7,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ChoiceChip}" Content="High" Tag="{Binding IsEditHigh}"
                                    Command="{Binding SetEditPriorityCommand}" CommandParameter="{x:Static m:Priority.High}"
                                    AutomationProperties.Name="Priority High" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource ChoiceChip}" Content="Medium" Tag="{Binding IsEditMedium}"
                                    Command="{Binding SetEditPriorityCommand}" CommandParameter="{x:Static m:Priority.Medium}"
                                    AutomationProperties.Name="Priority Medium" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource ChoiceChip}" Content="Low" Tag="{Binding IsEditLow}"
                                    Command="{Binding SetEditPriorityCommand}" CommandParameter="{x:Static m:Priority.Low}"
                                    AutomationProperties.Name="Priority Low" Margin="0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" Margin="2,8,0,0"/>
                        <TextBox x:Name="NotesBox" Grid.Column="1" Style="{StaticResource FieldBox}" Tag="Add notes (optional)" MaxLength="2000"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="96"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Due" Margin="2,9,0,0"/>
                        <Button x:Name="DateButton" Grid.Column="1" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Height="34"
                                Padding="12,0" Click="DateButton_Click" AutomationProperties.Name="Due date">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EditDateText}" FontWeight="Normal"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TimeBox" Grid.Column="2" Style="{StaticResource FieldBox}" Width="72" Height="34" Margin="8,0,0,0"
                                 Tag="HH:mm" MaxLength="5" AutomationProperties.Name="Due time"
                                 Text="{Binding EditTime, UpdateSourceTrigger=PropertyChanged}" KeyDown="TitleBox_KeyDown"/>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="2,0,0,0"
                                ToolTip="Clear due date" AutomationProperties.Name="Clear due date"
                                Command="{Binding ClearDueCommand}"/>
                        <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Closed="DatePopup_Closed">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Style="{StaticResource ChoiceChip}" Content="Today" Click="Today_Click" AutomationProperties.Name="Due today"/>
                                        <Button Style="{StaticResource ChoiceChip}" Content="Tomorrow" Click="Tomorrow_Click" AutomationProperties.Name="Due tomorrow"/>
                                        <Button Style="{StaticResource ChoiceChip}" Content="No date" Click="NoDate_Click" AutomationProperties.Name="No due date"/>
                                    </StackPanel>
                                    <c:MiniCalendar x:Name="Calendar" DateChosen="Calendar_DateChosen"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="List" Margin="2,7,0,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ListChoices}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChoiceChip}" Tag="{Binding IsSelected}" Margin="0,0,6,6"
                                            AutomationProperties.Name="{Binding Name, StringFormat=List {0}}"
                                            Command="{Binding DataContext.ChooseListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock Text="{Binding EditError}" Margin="2,0,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource OverdueBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,2">
                        <Button Style="{StaticResource TextButton}" Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelEditCommand}"
                                AutomationProperties.Name="Cancel edit"/>
                        <Button Style="{StaticResource PrimaryTextButton}" Content="Save" Command="{Binding SaveEditCommand}"
                                AutomationProperties.Name="Save task"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Insertion line while a row is dragged over this one. -->
        <Border x:Name="DropAbove" Style="{StaticResource DropLine}" VerticalAlignment="Top" Margin="8,-1,8,0"/>
        <Border x:Name="DropBelow" Style="{StaticResource DropLine}" VerticalAlignment="Bottom" Margin="8,0,8,1"/>
    </Grid>
</UserControl>
