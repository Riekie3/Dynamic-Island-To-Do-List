<UserControl x:Class="TaskIsland.App.Views.TaskRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskIsland.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <!-- Row actions show on hover and on keyboard focus (PLAN.md section 6.0). -->
        <Style x:Key="Actions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="12" Padding="10,8,6,8" Margin="0,0,0,4" MinHeight="52">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="Check" Style="{StaticResource RoundCheck}" IsChecked="{Binding IsCompleted}"
                      VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Title}"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ShowListName, Converter={StaticResource Vis}}">
                    <Ellipse Width="6" Height="6" Fill="{Binding ListBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ListName}" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0"
                        Visibility="{Binding HasDue, Converter={StaticResource Vis}}">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,4,0"/>
                <TextBlock Text="{Binding DueText}"/>
            </StackPanel>

            <c:PriorityChip Grid.Column="3" Priority="{Binding Priority}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0" Style="{StaticResource Actions}">
                <!-- Inline edit arrives in Phase 3, so the button is shown disabled until then. -->
                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" IsEnabled="False" ToolTip="Edit"
                        AutomationProperties.Name="Edit task"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete"
                        AutomationProperties.Name="Delete task"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
