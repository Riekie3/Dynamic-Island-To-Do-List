<UserControl x:Class="TaskIsland.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskIsland.App.Controls"
             xmlns:v="clr-namespace:TaskIsland.App.Views"
             xmlns:m="clr-namespace:TaskIsland.Core.Models;assembly=TaskIsland.Core"
             Width="420" MaxHeight="550" Focusable="False"
             FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- The expanded panel (PLAN.md section 6.4). Laid out once at its final size, revealed by the island clip. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: face (or tick) · title · count · more · close -->
        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Canvas x:Name="FaceHost" Width="105" Height="28" VerticalAlignment="Center" ClipToBounds="False"/>
            <Border x:Name="TickIcon" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                    Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="My To-Do List" Margin="12,0,10,1" FontFamily="{StaticResource DisplayFont}"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="2" MinWidth="22" Height="22" CornerRadius="11" Padding="7,0" Background="{DynamicResource AccentSoftBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding ScopeOutstanding}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Button x:Name="MoreButton" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More"
                    AutomationProperties.Name="More options" Click="More_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="MoreMenu">
                        <MenuItem Header="Exit TaskIsland" Click="Exit_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Collapse (Esc)"
                    AutomationProperties.Name="Collapse" Click="Close_Click"/>
        </Grid>

        <!-- 2. List switcher -->
        <ScrollViewer x:Name="ChipScroller" Grid.Row="1" Margin="0,6,0,0" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Chips_MouseWheel" Focusable="False">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ListChip}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAll}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count}" Margin="5,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- New list (ListEditPopup) arrives in Phase 3. -->
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE710;"
                        IsEnabled="False" ToolTip="New list" AutomationProperties.Name="New list"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Quick add -->
        <Border x:Name="QuickAdd" Grid.Row="2" Margin="0,10,0,8" Height="50" CornerRadius="14" Padding="14,0,7,0"
                Background="{DynamicResource SurfaceRaisedBrush}">
            <Border.RenderTransform><TranslateTransform x:Name="QuickAddShake"/></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="QuickAddBox" Grid.Column="1" Margin="10,0,8,0" Style="{StaticResource QuickAddBox}"
                         Tag="Add a new task…" MaxLength="500" AutomationProperties.Name="Add a new task"
                         Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="QuickAdd_KeyDown"/>
                <Button Grid.Column="2" Style="{StaticResource BareButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Command="{Binding CyclePriorityCommand}" ToolTip="Priority (click to change, right-click to pick)"
                        AutomationProperties.Name="Priority">
                    <c:PriorityChip Priority="{Binding NewPriority}"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:Priority.High}"/>
                            <MenuItem Header="Medium" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:Priority.Medium}"/>
                            <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static m:Priority.Low}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource PrimaryRoundButton}" Content="&#xE72A;" ToolTip="Add (Enter)"
                        AutomationProperties.Name="Add task" Command="{Binding AddCommand}"/>
            </Grid>
        </Border>

        <!-- 4. Task list: virtualised, only visible rows get visuals -->
        <Grid Grid.Row="3">
            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource OverlayScrollViewer}" CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><v:TaskRow/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 7. Empty state -->
            <StackPanel Margin="0,22,0,24" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding EmptyTitle}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyHint}" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 6. Footer: progress bar · counts · segmented filter -->
        <StackPanel Grid.Row="4" Margin="0,4,0,0">
            <Border Height="2" CornerRadius="1" Background="{DynamicResource SurfaceRaisedBrush}">
                <Border x:Name="ProgressBar" Background="{DynamicResource AccentBrush}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Border>
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="10" Padding="2" Background="{DynamicResource SurfaceRaisedBrush}">
                    <Grid>
                        <Border x:Name="FilterIndicator" Width="76" HorizontalAlignment="Left" CornerRadius="8"
                                Background="{DynamicResource SurfacePressedBrush}">
                            <Border.RenderTransform><TranslateTransform x:Name="FilterSlide"/></Border.RenderTransform>
                        </Border>
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton x:Name="FilterActive" Style="{StaticResource SegmentButton}" Width="76" Content="Active"
                                         GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="Active"/>
                            <RadioButton x:Name="FilterCompleted" Style="{StaticResource SegmentButton}" Width="76" Content="Completed"
                                         GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="Completed"/>
                            <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentButton}" Width="76" Content="All"
                                         GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
