<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon), its menu and the start-up TaskDialog (PLAN.md section 3.3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 asks WinForms apps to set DPI awareness in code. This is a WPF app: PLAN.md section 7.2 requires the
         PerMonitorV2 manifest, which WPF reads and WinForms (tray menu only) follows. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>TaskIsland</AssemblyName>
    <RootNamespace>TaskIsland.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- PLAN.md section 6.7 rule 9: no background GC thread (the heap is tiny), profile-guided tiering. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskIsland.Core\TaskIsland.Core.csproj" />
    <ProjectReference Include="..\TaskIsland.Data\TaskIsland.Data.csproj" />
    <ProjectReference Include="..\TaskIsland.Windows\TaskIsland.Windows.csproj" />
  </ItemGroup>

</Project>
