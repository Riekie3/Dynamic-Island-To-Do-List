<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon), its menu and the start-up TaskDialog (PLAN.md section 3.3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 asks WinForms apps to set DPI awareness in code. This is a WPF app: PLAN.md section 7.2 requires the
         PerMonitorV2 manifest, which WPF reads and WinForms (tray menu only) follows. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>TaskIsland</AssemblyName>
    <RootNamespace>TaskIsland.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/TaskIsland.ico</ApplicationIcon>
    <AssemblyTitle>TaskIsland</AssemblyTitle>
    <Description>TaskIsland - a Dynamic Island style to-do list for Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- PLAN.md section 6.7 rule 9: no background GC thread (the heap is tiny). Tiered compilation is off (Phase 6): it keeps
         both the quick and the optimised copy of hot code and the call-counting data; measured -13 MB private and -18 MB
         working set at idle for about +0.25 s cold start (DEVLOG Phase 6). TieredPGO needs tiering, so it is off too. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskIsland.Core\TaskIsland.Core.csproj" />
    <ProjectReference Include="..\TaskIsland.Data\TaskIsland.Data.csproj" />
    <ProjectReference Include="..\TaskIsland.Windows\TaskIsland.Windows.csproj" />
  </ItemGroup>

</Project>
